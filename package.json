{
  "name": "fullstack-auth-app",
  "version": "1.0.0",
  "description": "Production-Ready Full-Stack User Registration & Login Application",
  "scripts": {
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "build:client": "npm --prefix frontend run build",
    "test:backend": "node backend/test-auth.js"
  },
  "keywords": [
    "react",
    "vite",
    "nodejs",
    "express",
    "mongodb",
    "jwt",
    "bcrypt",
    "fullstack",
    "authentication"
  ],
